[flake8]
max-line-length = 120
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    .eggs,
    *.egg,
    dist,
    build,
    nzovu/api/common,
    nzovu/api/google,
    nzovu/api/message,
    nzovu/api/queue,
    nzovu/api/queueservice,
    nzovu/api/schedule,
    nzovu/api/schema
ignore =
    E203,
    E266,
    E501,
    W503,
    W504
per-file-ignores =
    __init__.py:F401
